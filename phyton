# This script uses three separate variables to store the names, and then simply prints them out in the reverse order from how they were entered 

# The Code #

# Ask the user for three names
name1 = input("Enter the first name: ")
name2 = input("Enter the second name: ")
name3 = input("Enter the third name: ")

# Print the names in reverse order
print("The names in reverse order are:")
print(name3)
print(name2)
print(name1)

